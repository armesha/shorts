# ============ LLM — Claude Code headless (paid Claude subscription, no fallback) ============
CLAUDE_BIN=claude
# For an unattended server: run `claude setup-token` once, paste the long-lived token here.
# (Locally you can leave this empty — it uses your existing Claude Code login.)
CLAUDE_CODE_OAUTH_TOKEN=

# ============ Rendering ============
# Path to a Chrome/Chromium binary (no browser download needed).
CHROME_PATH=/usr/bin/google-chrome

# ============ YouTube Data API (OAuth) ============
# ONE OAuth client (Client ID/Secret) authorizes MANY channels — one refresh token per channel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8080/oauth/callback

# ============ App ============
SECRET_KEY=change-me-please
DATABASE_PATH=data/app.db
OUTPUT_DIR=data/output
ASSETS_AUDIO_DIR=assets/audio

# ============ Auth (dashboard login) ============
# First admin, seeded into a fresh DB on boot. Put REAL values only in .env (gitignored).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Extra non-admin users, created on boot if missing: name:pass,name2:pass2
SEED_USERS=
# Login lockout + session tuning (defaults shown)
AUTH_MAX_ATTEMPTS=10
AUTH_LOCK_MINUTES=15
SESSION_TTL_DAYS=30
# SESSION_COOKIE_SECURE=1   # set this when serving over HTTPS

# ============ Telegram login (optional) ============
# Bot from @BotFather. Server-only secret: verifies the Telegram Login Widget
# signature (HMAC over SHA256(token)). NEVER expose to the frontend. Put the REAL
# value only in .env (gitignored). For the widget, also run /setdomain in @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public HTTPS base URL of the site — needed to register the bot webhook (login/bind via /start).
# Empty → webhook is NOT set (the bot deep-link flow won't receive updates; recovery codes still work).
PUBLIC_BASE_URL=
