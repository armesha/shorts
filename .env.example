# ============ LLM — Claude Code headless (paid Claude subscription, no fallback) ============
CLAUDE_BIN=claude
# For an unattended server: run `claude setup-token` once, paste the long-lived token here.
# (Locally you can leave this empty — it uses your existing Claude Code login.)
CLAUDE_CODE_OAUTH_TOKEN=

# ============ Rendering ============
# Path to a Chrome/Chromium binary (no browser download needed).
CHROME_PATH=/usr/bin/google-chrome

# ============ YouTube Data API (OAuth) ============
# ONE OAuth client (Client ID/Secret) authorizes MANY channels — one refresh token per channel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8080/oauth/callback

# ============ App ============
SECRET_KEY=change-me-please
DATABASE_PATH=data/app.db
OUTPUT_DIR=data/output
ASSETS_AUDIO_DIR=assets/audio
