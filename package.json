{
  "name": "shorts-factory",
  "version": "0.1.0",
  "description": "Automated YouTube Shorts generation & upload pipeline (HTML template -> image -> video -> scheduled upload). LLM via Claude Code headless.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,green \"npm run server\" \"npm run web\"",
    "setup": "npm install",
    "postinstall": "cd web && npm install --ignore-scripts",
    "server": "node --import tsx --experimental-sqlite server/index.ts",
    "worker:gen": "node --import tsx --experimental-sqlite server/gen-worker.ts",
    "server:dev": "node --import tsx --experimental-sqlite --watch server/index.ts",
    "server:restart": "node scripts/restart-server.mjs",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "deploy:restart": "npm run web:build && npm run server:restart",
    "smoke:live": "node scripts/smoke-live.mjs",
    "deploy:refresh": "npm run web:build && npm run server:restart && npm run smoke:live",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tunnel": "node scripts/tunnel.mjs",
    "share": "npm run web:build && concurrently -k -n app,tunnel -c blue,magenta \"npm run server\" \"npm run tunnel\"",
    "render:preview": "tsx src/scripts/render-preview.ts",
    "gen:preview": "tsx src/scripts/generate-preview.ts",
    "e2e:account-ui": "node --experimental-sqlite --import tsx src/scripts/account-ui-e2e.ts",
    "ru:audit": "tsx src/scripts/ru-render-audit.ts",
    "ru:rerender": "node --experimental-sqlite --import tsx src/scripts/ru-rerender-broken.ts",
    "test": "node --import tsx --experimental-sqlite --test 'src/**/*.test.ts' 'server/**/*.test.ts'"
  },
  "keywords": [
    "youtube",
    "shorts",
    "automation",
    "puppeteer",
    "ffmpeg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@types/node": "^25.9.3",
    "fastify": "^5.8.5",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^173.0.0",
    "node-cron": "^4.2.1",
    "puppeteer-core": "^25.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "concurrently": "^10.0.3",
    "playwright": "^1.60.0"
  }
}
